# Copy to .env and fill in — used by `docker run --env-file .env`.

# GitHub Release asset with data/embeddings + data/serve, downloaded and extracted
# by docker-entrypoint.sh on first start. See README, "Run the API".
DATA_URL=https://github.com/<user>/<repo>/releases/download/<tag>/data.zip

# Optional but recommended: sha256 of the asset above (GitHub shows this on the
# release's asset list, or `sha256sum data.zip` locally). The "sha256:" prefix is
# optional. Skipped if unset.
DATA_SHA256=

# Comma-separated origins allowed to call the API cross-origin, e.g. the GitHub
# Pages URL. Defaults to "*" (safe here — no cookies/auth involved) if unset.
CORS_ORIGINS=https://<user>.github.io
